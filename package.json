{
  "name": "@fitzyracing1/ms",
  "version": "2.1.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitzyracing1/ms.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Tiny millisecond conversion utility",
  "main": "./index",
  "files": [
    "index.js",
    "PATCH-CLOUD.md"
  ],
  "scripts": {
    "precommit": "lint-staged",
    "lint": "eslint lib/* bin/*",
    "test": "mocha tests.js"
  },
  "eslintConfig": {
    "extends": "eslint:recommended",
    "env": {
      "node": true,
      "es6": true
    }
  },
  "lint-staged": {
    "*.js": [
      "npm run lint",
      "prettier --single-quote --write",
      "git add"
